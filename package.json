{
  "name": "@banshee.com/iso7813parser",
  "version": "1.0.11",
  "description": "ISO/IEC 7813 magnetic stripe card data parser using Chevrotain",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "iso7813": "dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm test && pnpm build",
    "parse": "node dist/cli.js",
    "release": "pnpm publish --registry https://registry.npmjs.org --access public"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banshee/iso7813parser.git"
  },
  "keywords": [
    "magstripe",
    "magnetic-stripe",
    "giftcard",
    "iso-7813",
    "iso7813",
    "chevrotain",
    "parser"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "chevrotain": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
